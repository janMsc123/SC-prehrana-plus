# --- required ---
# Used to sign login sessions AND to encrypt stored school passwords.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
# Changing this invalidates sessions and makes stored passwords unreadable.
SECRET_KEY=change-me-to-a-long-random-string

# --- school system ---
MALCOMAT_BASE_URL=https://prehrana.sc-celje.si

# --- ordering behaviour ---
# true  = the weekly job places real orders in the school system
# false = it computes and logs the picks but writes nothing
PLACE_ORDERS=true

# --- schedule (server local time) ---
# Collector: reads the menu and stores it. Never writes to the school system.
COLLECT_CRON_HOUR=6
COLLECT_CRON_MINUTE=30
# Picker: chooses meals for the orderable window.
PICK_CRON_DAY_OF_WEEK=mon
PICK_CRON_HOUR=7
PICK_CRON_MINUTE=0

TZ=Europe/Ljubljana
DATABASE_PATH=/data/prehrana.db

# --- suggestions (optional) ---
# Chat webhook that classmates' suggestions are forwarded to (Discord, Slack,
# ...). THIS IS A CREDENTIAL: anyone who has it can post into your channel, so
# keep it here in .env and never commit it. If a URL ever leaks, delete the
# webhook in your server settings and make a new one.
# Leave blank to keep suggestions in the local database only.
SUGGESTIONS_WEBHOOK_URL=
