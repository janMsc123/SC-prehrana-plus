# --- required ---
# Used to sign login sessions AND to encrypt stored school passwords.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
# Changing this invalidates sessions and makes stored passwords unreadable.
SECRET_KEY=change-me-to-a-long-random-string

# --- school system ---
MALCOMAT_BASE_URL=https://prehrana.sc-celje.si

# --- ordering behaviour ---
# true  = the weekly job places real orders in the school system
# false = it computes and logs the picks but writes nothing
PLACE_ORDERS=true

# --- schedule (server local time) ---
# Collector: reads the menu and stores it. Never writes to the school system.
COLLECT_CRON_HOUR=6
COLLECT_CRON_MINUTE=30
# Picker: chooses meals for the orderable window.
# Runs daily by default, and that matters: cutoffs do not all fall on the same
# weekday -- Monday's order closes on Saturday. Because the picker asks the
# school which dates are orderable *right now*, a daily run takes each date the
# first morning it becomes available, so no cutoff is ever missed. A weekly run
# silently loses every day whose cutoff falls before it.
# Set a single weekday (e.g. mon) only if you truly want one run per week.
PICK_CRON_DAY_OF_WEEK=*
PICK_CRON_HOUR=7
PICK_CRON_MINUTE=0

TZ=Europe/Ljubljana
DATABASE_PATH=/data/prehrana.db

# --- suggestions (optional) ---
# Chat webhook that classmates' suggestions are forwarded to (Discord, Slack,
# ...). THIS IS A CREDENTIAL: anyone who has it can post into your channel, so
# keep it here in .env and never commit it. If a URL ever leaks, delete the
# webhook in your server settings and make a new one.
# Leave blank to keep suggestions in the local database only.
SUGGESTIONS_WEBHOOK_URL=

# --- maintenance ---
# Who may answer the "is this the same dish?" questions. Merging two meals
# rewrites the shared archive for every user, so it is upkeep for whoever runs
# the instance, not something each classmate should be shown.
# Comma-separated usernames. Empty means nobody sees the page at all.
ADMIN_USERNAMES=

# Slot that is on offer every school day (MALICA 7 at our school). It acts as
# the floor rather than a choice: it is never put to the rating pass, and it is
# ordered on any day where nothing else clears it, so nobody is left without
# lunch. Matched case-insensitively against the school's slot name. If the name
# does not match, the feature is simply inert -- a day with nothing ranked is
# skipped, exactly as before. Blank disables it.
FALLBACK_SLOT_NAME=MALICA 7
